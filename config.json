{
  "server": {
    "port": "8081",
    "host": "0.0.0.0",
    "allowed_origins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "https://yourdomain.com"
    ],
    "read_timeout": 600,
    "write_timeout": 600,
    "max_request_size": 1048576
  },
  "database": {
    "path": "./data/qng_agent.leveldb",
    "type": "leveldb"
  },
  "llm": {
    "default_provider": "openai",
    "default_model": "gpt-4",
    "max_tokens": 2048,
    "temperature": 0.7,
    "timeout": 300
  },
  "mcp": {
    "default_servers": [
      {
        "name": "QNG Tools",
        "url": "http://localhost:8080/sse",
        "enabled": true
      }
    ],
    "timeout": 300
  },
  "log": {
    "level": "debug"
  }
}
